PORT=3000
HOST=0.0.0.0
POSTGRES_PASSWORD=local-only-password
DATABASE_URL=postgres://fieldproof:local-only-password@localhost:5432/fieldproof
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# Public endpoint used by iOS for signed PUTs; must reach the same bucket.
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=fieldproof
OBJECT_STORAGE_ACCESS_KEY=fieldproof
OBJECT_STORAGE_SECRET_KEY=local-only-storage-password
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_HCS_TOPIC_ID=
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
# Reserve this amount for network fees, separately from task rewards.
HEDERA_FEE_RESERVE_HBAR=2
VERIFIER_MODE=mock
MOCK_VERIFIER_SCENARIO=approve
# Applies only to new tasks. Existing tasks retain their stored mode.
VERIFICATION_PAYMENT_MODE=x402
BLOCKY402_BASE_URL=https://api.testnet.blocky402.com
X402_VERIFIER_PRICE_HBAR=0.001
X402_PAY_TO_ACCOUNT_ID=
# Set these in a private .env.agent used only by the CLI, not the server .env.
AGENT_HEDERA_ACCOUNT_ID=
AGENT_HEDERA_PRIVATE_KEY=
X402_JOURNAL_DIR=.x402-payments
# Seed tokens once. Replace with at least 32 random characters each.
AGENT_API_TOKEN=
WORKER_API_TOKEN=
OPERATOR_API_TOKEN=
API_BASE_URL=http://localhost:3000
DEMO_PAYOUT_ACCOUNT_ID=
# HTTPS deployment only; point both DNS names to the server.
API_DOMAIN=
STORAGE_DOMAIN=
