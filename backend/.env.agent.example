# Copy to .env.agent and keep it only on the machine that signs x402 payments.
# Hedera Portal exposes the required DER-encoded private key.
AGENT_HEDERA_ACCOUNT_ID=
AGENT_HEDERA_PRIVATE_KEY=

# Optional overrides. If omitted, these values are inherited from .env.
# AGENT_API_TOKEN=
# API_BASE_URL=http://localhost:3000
# X402_PAY_TO_ACCOUNT_ID=
# X402_JOURNAL_DIR=.x402-payments
